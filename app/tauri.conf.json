{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CabinOS",
  "version": "2.4.0",
  "identifier": "com.elabuelostreaming.cabinos",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": {
      "script": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tools/build-dev.ps1",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tools/build-release.ps1",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CabinOS",
        "width": 900,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "El Abuelo Streaming",
    "copyright": "Copyright © 2026 El Abuelo Streaming. CabinOS is distributed under GPL-3.0-or-later and retains applicable third-party notices.",
    "category": "Game",
    "shortDescription": "Sistema de infoentretenimiento personalizable para Euro Truck Simulator 2",
    "longDescription": "CabinOS es una aplicación independiente para Euro Truck Simulator 2 que integra una pantalla de cabina, mapas locales, telemetría y herramientas de personalización. Proyecto comunitario derivado de WestPlay bajo GPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/dist/": "ui/",
      "../target/release/cabinos.dll": "cabinos.dll",
      "../target/release/cabinos-probe.exe": "cabinos-probe.exe",
      "../target/release/cabinos-maps.exe": "cabinos-maps.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2OTc1ODBDNjdDNTc3Q0UKUldUT2Q4Vm5ERmlYVnQvV0dLdVVNUWtlcjlpKzB3MVVNeVJVeHhXNHFGVUNaU2xpVDNNVjhkWmEK",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
